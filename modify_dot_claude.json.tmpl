#!/usr/bin/env bash
# Modify script for ~/.claude.json
# Merges managed MCP servers into existing Claude global config.
# Managed: mcpServers, projects[*].enabledMcpServers
# Free: everything else (numStartups, tipsHistory, installMethod, cachedGrowthBookFeatures, etc.)
set -euo pipefail

current=$(cat)
[ -z "$current" ] && current='{}'

# ── Base MCP servers: shared across all machines ─────────────────────────────
read -r -d '' base_mcps << 'MCPS' || true
{
  "open-websearch": {
    "command": "npx",
    "args": ["-y", "open-websearch"]
  },
  "context7": {
    "command": "npx",
    "args": ["-y", "@upstash/context7-mcp@latest"]
  },
  "mcp-deepwiki": {
    "command": "npx",
    "args": ["-y", "mcp-deepwiki@latest"]
  },
  "tempograph": {
    "command": "uvx",
    "args": ["--from", "tempograph[full]", "tempograph-server"]
  },
  "oss-autopilot": {
    "command": "npx",
    "args": ["-y", "@oss-autopilot/mcp@latest"]
  },
  "chisel": {
    "command": "chisel",
    "args": ["--stdio", "--root", "/"]
  },
  "codex": {
    "command": "npx",
    "args": ["-y", "claude-codex-bridge@0.3.1", "serve", "codex"]
  },
  "terminal": {
    "command": "uvx",
    "args": ["terminal-mcp"]
  }
{{- if eq .chezmoi.hostname "nimbus" }}
  ,"automation": {
    "command": "bun",
    "args": ["run", "/Users/rai/dev/github/ashwwwin/automation-mcp/index.ts", "--stdio"]
  }
  ,"cortex": {
    "command": "node",
    "args": ["/Users/rai/dev/lumiere/apps/cortex-cc/vendor/cortex-mcp/index.cjs"],
    "env": {
      "CORTEX_CONFIG": "/Users/rai/navi/cortex.config.json",
      "DATABASE_URL": "postgresql://expedition:expedition-pipeline-2026@127.0.0.1:5433/pipeline",
      "CORTEX_DRIZZLE_PATH": "/Users/rai/dev/lumiere/apps/cortex-cc/vendor/cortex-mcp/drizzle"
    }
  }
{{- end }}
{{- if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "arch") (and (hasKey .chezmoi.osRelease "idLike") (eq .chezmoi.osRelease.idLike "arch"))) }}
  ,"arch-linux": {
    "command": "uvx",
    "args": ["arch-ops-server"]
  }
{{- end }}
}
MCPS

# Inject exa MCP (HTTP mode) with API key from environment
base_mcps=$(echo "$base_mcps" | jq --arg key "${EXA_API_KEY:-}" \
  '.exa = {"type": "http", "url": "https://mcp.exa.ai/mcp?enableAdvancedSearch=true", "headers": {"x-api-key": $key}}')

# Replace: base is authoritative for MCP servers. Removals from base
# are reflected in the deployed config. All other fields untouched.
#
# Also scrub the poisoned 1M-context entitlement cache keys on every apply.
# See anthropics/claude-code#45449 and logs/claude.md. The server emits a
# stale `org_level_disabled` reason header on Max personal plans, which the
# client caches and uses to block /model opus[1m] even though the 1M
# entitlement is actually valid. Deleting these keys (plus the env var in
# dot_zshenv.tmpl) keeps the slash command from tripping on stale state.
# ── Built-in MCP servers to enable across all projects ──────────────────────
# computer-use is a default-disabled built-in; opt-in stored per-project in
# .projects[path].enabledMcpServers inside ~/.claude.json.
builtin_mcps='["computer-use"]'

echo "$current" | jq --argjson base "$base_mcps" --argjson builtins "$builtin_mcps" '
  .mcpServers = $base
  | del(.cachedExtraUsageDisabledReason)
  | del(.hasAvailableSubscription)
  | del(.s1mAccessCache)
  | del(.passesEligibilityCache)
  | del(.clientDataCache)
  | if .oauthAccount then .oauthAccount |= del(.hasExtraUsageEnabled) else . end
  | if .projects then .projects |= with_entries(
      .value.enabledMcpServers = ((.value.enabledMcpServers // []) + $builtins | unique)
    ) else . end
'
