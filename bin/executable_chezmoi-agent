#!/usr/bin/env python3
"""chezmoi-agent: run chezmoi as an AGENT, reading secrets through a 1Password
service account instead of Rai's interactive op session.

Usage:  chezmoi-agent [--agent NAME] <any chezmoi args...>
        e.g.  chezmoi-agent diff      chezmoi-agent apply

- Agent name: --agent, else $ARK_AGENT, else by hostname (nimbus -> navi,
  latios -> tilly).
- Token: ~/.config/op/<agent>-token (must be mode 600, never in git).
- Builds a throwaway config from ~/.config/chezmoi/chezmoi.toml with
  [onepassword] mode = "service", and keeps the REAL persistent state file so
  run_once/run_onchange scripts are not re-run.
- The token is passed only in the child chezmoi's environment. Never export
  OP_SERVICE_ACCOUNT_TOKEN in an interactive shell: chezmoi in account mode
  (Rai's normal runs) refuses to run when it is set.
"""
import os, socket, stat, subprocess, sys, tempfile, tomllib

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config/chezmoi/chezmoi.toml")
STATE = os.path.join(HOME, ".config/chezmoi/chezmoistate.boltdb")
HOST_AGENT = {"nimbus": "navi", "latios": "tilly"}


def die(msg):
    print(f"chezmoi-agent: {msg}", file=sys.stderr)
    sys.exit(2)


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, str):
        return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    die(f"unsupported config value type {type(v).__name__}")


def dump(d, prefix=""):
    out, tables = [], []
    for k, v in d.items():
        if isinstance(v, dict):
            tables.append((k, v))
        else:
            out.append(f"{k} = {toml_value(v)}")
    for k, v in tables:
        name = f"{prefix}{k}"
        out.append(f"\n[{name}]")
        out.extend(dump(v, name + "."))
    return out


def main():
    args = sys.argv[1:]
    agent = None
    if args[:1] == ["--agent"] and len(args) > 1:
        agent, args = args[1], args[2:]
    agent = agent or os.environ.get("ARK_AGENT") or HOST_AGENT.get(
        socket.gethostname().split(".")[0].lower()
    )
    if not agent:
        die("cannot tell which agent this is; pass --agent NAME")

    token_path = os.path.join(HOME, ".config/op", f"{agent}-token")
    try:
        st = os.stat(token_path)
    except FileNotFoundError:
        die(f"no token at {token_path}")
    if stat.S_IMODE(st.st_mode) & 0o077:
        die(f"{token_path} is readable by others; chmod 600 it")
    token = open(token_path).read().strip()
    if not token:
        die(f"{token_path} is empty")

    with open(CFG, "rb") as f:
        cfg = tomllib.load(f)
    op = cfg.setdefault("onepassword", {})
    op["mode"] = "service"
    op.pop("prompt", None)  # account-mode only

    env = dict(os.environ)
    env["OP_SERVICE_ACCOUNT_TOKEN"] = token
    with tempfile.TemporaryDirectory(prefix="chezmoi-agent-") as d:
        os.chmod(d, 0o700)
        p = os.path.join(d, "chezmoi.toml")
        with open(p, "w") as f:
            f.write("\n".join(dump(cfg)) + "\n")
        rc = subprocess.call(
            ["chezmoi", "--config", p, "--persistent-state", STATE, *args], env=env
        )
    sys.exit(rc)


if __name__ == "__main__":
    main()
