#!/bin/bash
# openagent — launch opencode with the oh-my-openagent framework profile.
#
# `opencode`  -> default ~/.config/opencode      (vanilla: providers + MCP, no framework)
# `openagent` -> ~/.config/opencode-openagent    (vanilla base + oh-my-openagent on top)
#
# Both profiles share the same base config (providers, MCP servers) via chezmoi's
# .chezmoitemplates/opencode-shared-base. This wrapper just points opencode at the
# openagent config dir; everything else (slash commands, args) passes straight through.
set -euo pipefail

export OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode-openagent}"

# Opt out of oh-my-openagent anonymous telemetry by default.
export OMO_DISABLE_POSTHOG="${OMO_DISABLE_POSTHOG:-1}"
export OMO_SEND_ANONYMOUS_TELEMETRY="${OMO_SEND_ANONYMOUS_TELEMETRY:-0}"

# Cursor (opencode-cursor plugin) backend selection.
#
# Force the SDK backend (@cursor/sdk via CURSOR_API_KEY). The default `auto` mode
# prefers the `cursor-agent` CLI when it's installed — but that backend spawns a
# FULL Cursor agent per request with its own system prompt + Shell-tool surface,
# which collides with oh-my-openagent's tool/agent loop ("tool surface" breakage).
# The SDK backend keeps tool-loop mode = opencode: OpenCode/omo own the tool list
# and cursor-acp only translates tool-call protocol boundaries. Requires a real
# CURSOR_API_KEY (cursor.com/settings) — which we export from 1Password in zshenv.
export CURSOR_ACP_BACKEND="${CURSOR_ACP_BACKEND:-sdk}"
# Keep omo/opencode as the tool executor (default, pinned for certainty).
export CURSOR_ACP_TOOL_LOOP_MODE="${CURSOR_ACP_TOOL_LOOP_MODE:-opencode}"
# --force still auto-trusts the dir if the SDK ever falls back to cursor-agent.
export CURSOR_ACP_FORCE="${CURSOR_ACP_FORCE:-1}"

exec opencode "$@"
