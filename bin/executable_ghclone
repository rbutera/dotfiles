#!/usr/bin/env bash
# ghclone — clone a GitHub repo to a consistent location and print the path.
# Usage:
#   ghclone org/repo     → clones to ~/dev/github/org/repo
#   ghclone repo         → clones to ~/dev/repo (assumes your own GitHub account)
#
# Designed to be called from a shell function that cds to the printed path.
# All messages go to stderr; only the target directory goes to stdout.

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "usage: ghclone [org/]repo" >&2
    exit 1
fi

ARG="$1"
GH_USER=$(git config --global github.user 2>/dev/null || echo "rbutera")

if [[ "$ARG" == */* ]]; then
    ORG="${ARG%%/*}"
    REPO="${ARG##*/}"
    TARGET="$HOME/dev/github/$ORG/$REPO"
    CLONE_URL="https://github.com/$ORG/$REPO"
else
    REPO="$ARG"
    ORG="$GH_USER"
    TARGET="$HOME/dev/$REPO"
    CLONE_URL="https://github.com/$GH_USER/$REPO"
fi

if [[ -d "$TARGET" ]]; then
    # Check if it's a git repo pointing at the right remote
    existing=$(git -C "$TARGET" remote get-url origin 2>/dev/null || echo "")
    if [[ "$existing" == *"$ORG/$REPO"* ]]; then
        echo "repository '$ORG/$REPO' already cloned at $TARGET" >&2
        echo "$TARGET"
        exit 0
    else
        echo "error: '$TARGET' exists but has a different origin: $existing" >&2
        exit 1
    fi
fi

mkdir -p "$(dirname "$TARGET")"

if command -v gh &>/dev/null; then
    gh repo clone "$ORG/$REPO" "$TARGET" >&2
else
    git clone "$CLONE_URL" "$TARGET" >&2
fi

# Initialise submodules if present
if [[ -f "$TARGET/.gitmodules" ]]; then
    git -C "$TARGET" submodule update --init --recursive >&2
fi

echo "$TARGET"
