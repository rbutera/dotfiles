#!/usr/bin/env bash
# Modify script for ~/.claude/settings.json
# Merges managed base config into existing settings.
# Managed: cleanupPeriodDays, skillListingBudgetFraction, teammateMode, enabledPlugins,
#          permissions.defaultMode
# Free: the REST of permissions (allow/deny lists), model, attribution,
#       skipDangerousModePermissionPrompt, etc.
#
# permissions.defaultMode is managed deliberately (2026-07-24). A CLI
# --dangerously-skip-permissions flag applies only to the session you launched;
# SPAWNED SUBAGENTS start as their own sessions, do not inherit it, and fall back
# to these settings files. With no defaultMode set they hit a permission prompt
# that nobody can answer and block SILENTLY - indistinguishable from slow work
# from the orchestrator's side. Setting it here is what makes subagents inherit
# it. Note this only sets .permissions.defaultMode, so any allow/deny list in the
# deployed file survives untouched.
set -euo pipefail

current=$(cat)
[ -z "$current" ] && current='{}'

# ── Base config: fields we want on all machines ──────────────────────────────
read -r -d '' base << 'BASE' || true
{
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.02,
  "permissions": {"defaultMode": "bypassPermissions"},
  "teammateMode": "in-process",
  "tui": "fullscreen",
  "editorMode": "vim",
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "showThinkingSummaries": false,
  "viewMode": "verbose",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-supermemory@supermemory-plugins": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": false
  },
  "orcaHook": {
    "matcher": "*",
    "hooks": [{"type": "command", "command": "if [ -f '/Users/rai/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/rai/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/rai/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/rai/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi", "timeout": 10}]
  },
  "agentDeliveryHook": {
    "matcher": "Agent",
    "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/hooks/agent-delivery-rule.py\""}]
  }
}
BASE

# Merge: base wins for managed keys, existing wins for everything else.
# enabledPlugins is additive — base plugins always present, extras preserved.
# Ghostty notifications on macOS/Linux only, not Windows
notif_channel="auto"
case "$(uname -s)" in Darwin|Linux) notif_channel="ghostty" ;; esac

# rtk hook + Orca agent-hook on macOS only. Both are managed so `chezmoi apply`
# preserves them (the PreToolUse array is set wholesale below); the Orca hook was
# previously live-in-deployed-config only and would otherwise be dropped on apply.
is_mac=false
[ "$(uname -s)" = "Darwin" ] && is_mac=true

# agent-delivery-rule hook: appends the SendMessage delivery rule to every
# BACKGROUND Agent dispatch, so no prompt author has to remember it. See the
# docstring in dot_claude/hooks/executable_agent-delivery-rule.py for why.
# POSIX-only because it shells out to python3 with a $HOME path; Windows keeps
# its existing (empty) PreToolUse config rather than getting a broken command.
is_posix=false
case "$(uname -s)" in Darwin|Linux) is_posix=true ;; esac

echo "$current" | jq --argjson base "$base" --arg notif "$notif_channel" --argjson mac "$is_mac" --argjson posix "$is_posix" '
  .cleanupPeriodDays = $base.cleanupPeriodDays |
  .skillListingBudgetFraction = $base.skillListingBudgetFraction |
  .permissions.defaultMode = $base.permissions.defaultMode |
  .teammateMode = $base.teammateMode |
  .tui = $base.tui |
  .editorMode = $base.editorMode |
  .preferredNotifChannel = $notif |
  .attribution = $base.attribution |
  .showThinkingSummaries = $base.showThinkingSummaries |
  .viewMode = $base.viewMode |
  del(.env) |
  .enabledPlugins = ((.enabledPlugins // {}) * $base.enabledPlugins |
    del(.["plugin-dev@claude-plugins-official"],
        .["mcp-server-dev@claude-plugins-official"],
        .["slack@claude-plugins-official"],
        .["discord@claude-plugins-official"],
        .["context7@claude-plugins-official"],
        .["chrome-devtools-mcp@claude-plugins-official"],
        .["codex@openai-codex"])) |
  del(.extraKnownMarketplaces["openai-codex"]) |
  if ($mac or $posix) then
    .hooks.PreToolUse =
      (if $mac then [{"matcher": "Bash", "hooks": [{"type": "command", "command": "rtk hook claude"}]}, $base.orcaHook] else [] end)
      + (if $posix then [$base.agentDeliveryHook] else [] end)
  else . end
'
