        "additionalModels": [
          { "id": "claude-opus-5", "label": "Claude Opus 5" }
        ],
        "enabled": true
      },
      "claude": {
        "additionalModels": [
          { "id": "claude-opus-5", "label": "Claude Opus 5" }
        ]
      }
    }
