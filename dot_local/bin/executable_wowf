#!/usr/bin/env python3
"""wowf: WoW Forever lookups on Wowhead (forever data env).

  wowf tip <item|quest|npc|spell|zone> <id>   tooltip as plain text (nether JSON, curl-friendly)
  wowf find <terms...>                        search suggestions (type, id, name); may 403, then use a browser
  wowf guide <slug-or-url>                    guide text (e.g. classes/paladin/retribution/dps-leveling-tips)
  wowf url <item|quest|npc|spell|zone> <id>   page URL to give Rai or open in a browser
  wowf url search <terms...>                  search page URL

Endpoints verified 2026-11-07. Entity pages (item=, quest=...) 403 to curl (CloudFront);
the nether tooltip endpoint does not. Search, suggestions and guide pages work only with a
plain custom User-Agent (curl's default and browser UAs get 403), hence UA below.
"""
import html, json, re, sys, urllib.parse, urllib.request

TYPES = {"item", "quest", "npc", "spell", "zone"}
UA = {"User-Agent": "wowf/1.0"}


def get(url):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read().decode("utf-8", "replace")


def text(tooltip_html):
    t = re.sub(r"<br\s*/?>|</tr>|</table>|</div>", "\n", tooltip_html)
    t = re.sub(r"</t[dh]>", "  ", t)
    t = re.sub(r"<!--.*?-->|<[^>]+>", "", t, flags=re.S)
    lines = [re.sub(r"[ \t]+", " ", html.unescape(l)).strip() for l in t.splitlines()]
    return "\n".join(l for l in lines if l)


def tip(kind, ident):
    d = json.loads(get(f"https://nether.wowhead.com/forever/tooltip/{kind}/{ident}"))
    if "error" in d or not d.get("tooltip"):
        sys.exit(f"no {kind} {ident} in Forever data")
    print(text(d["tooltip"]))
    print(f"\nhttps://www.wowhead.com/forever/{kind}={ident}")


def find(terms):
    q = urllib.parse.quote_plus(terms)
    try:
        d = json.loads(get(f"https://www.wowhead.com/forever/search/suggestions-template?q={q}"))
    except Exception as e:
        sys.exit(f"search blocked or failed ({e}). Open in a browser: "
                 f"https://www.wowhead.com/forever/search?q={q}")
    for r in d.get("results", [])[:15]:
        print(f"{r.get('typeName', r.get('type'))}\t{r.get('id')}\t{r.get('name')}")


def guide(slug):
    url = slug if slug.startswith("http") else "https://www.wowhead.com/forever/guide/" + slug.strip("/")
    page = get(url)
    m = re.search(r'WH\.markup\.printHtml\(("(?:[^"\\]|\\.)*")', page)
    if not m:
        sys.exit(f"no guide markup found at {url}")
    body = json.loads(m.group(1))
    body = re.sub(r"\[(item|npc|quest|spell|zone)=(\d+)[^\]]*\]", r"[\1 \2]", body)
    body = re.sub(r"\[/?(?:b|i|u|h\d|ul|ol|li|table|tr|td|th|center|small|url[^\]]*|icon[^\]]*|color[^\]]*|toc[^\]]*|tab[^\]]*|tabs[^\]]*|div[^\]]*|span[^\]]*|hr|pad|img[^\]]*|minibox|accordion[^\]]*)\]", "", body)
    print(re.sub(r"\n{3,}", "\n\n", body).strip())
    print("\n" + url)


def main(a):
    if len(a) >= 3 and a[0] == "tip" and a[1] in TYPES:
        return tip(a[1], a[2])
    if len(a) == 2 and a[0] == "guide":
        return guide(a[1])
    if len(a) >= 2 and a[0] == "find":
        return find(" ".join(a[1:]))
    if len(a) >= 3 and a[0] == "url" and a[1] == "search":
        return print("https://www.wowhead.com/forever/search?q=" + urllib.parse.quote_plus(" ".join(a[2:])))
    if len(a) == 3 and a[0] == "url" and a[1] in TYPES:
        return print(f"https://www.wowhead.com/forever/{a[1]}={a[2]}")
    sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
