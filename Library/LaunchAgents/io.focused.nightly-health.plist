<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.focused.nightly-health</string>

    <!--
    ProgramArguments: invoke the wrapper script directly via /bin/bash.
    The wrapper sets its own environment and enforces the overall deadline.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rai/focused/scripts/health/nightly-health.sh</string>
    </array>

    <!--
    StartCalendarInterval: fire Mon-Fri at 07:00 local time.
    Weekday: 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday.
    launchd skips days when the machine is asleep and catches up on wake
    (the same-day idempotency guard in run.sh prevents a double-run on wake).
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Do NOT fire when launchd loads the plist. Arm manually via launchctl. -->
    <key>RunAtLoad</key>
    <false/>

    <!--
    EnvironmentVariables: launchd provides a minimal environment.
    PATH must include:
      /Users/rai/.local/bin     -- rtk, chezmoi, local scripts
      /Users/rai/.asdf/shims    -- node (required by ark)
      /opt/homebrew/bin         -- colima, docker, dolt, timeout/gtimeout
      /usr/local/bin            -- fallback
      /usr/bin, /bin            -- system tools
    HOME must be explicit (launchd may set it to / or omit it).
    ARK_WORKSPACE_ROOT tells ark which workspace is florence's.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rai</string>
        <key>PATH</key>
        <string>/Users/rai/.local/bin:/Users/rai/.asdf/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>ARK_WORKSPACE_ROOT</key>
        <string>/Users/rai/focused</string>
    </dict>

    <!--
    Log paths: plist-level stdout/stderr capture the wrapper's own echo lines.
    run.sh writes its structured report to scripts/health/logs/last-report.md
    and its rolling log to scripts/health/logs/health.log (with rotation).
    The plist-level logs capture the wrapper shell's own output only -- they
    are a secondary diagnostic surface, not the primary health log.
    -->
    <key>StandardOutPath</key>
    <string>/Users/rai/focused/scripts/health/logs/nightly-health-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rai/focused/scripts/health/logs/nightly-health-launchd-error.log</string>

    <!--
    THIS PLIST IS INERT UNTIL ARMED.

    chezmoi apply deploys it to ~/Library/LaunchAgents/io.focused.nightly-health.plist
    but does NOT load it. launchd only fires it after a manual arm step.

    ARM (to start the Mon-Fri 07:00 schedule):
      chezmoi apply ~/Library/LaunchAgents/io.focused.nightly-health.plist
      launchctl load ~/Library/LaunchAgents/io.focused.nightly-health.plist

    DISARM (to stop the schedule without removing the file):
      launchctl unload ~/Library/LaunchAgents/io.focused.nightly-health.plist

    VERIFY (after arming):
      launchctl list | grep nightly-health

    MANUAL RUN (one-shot, does not affect the schedule):
      launchctl start io.focused.nightly-health

    DRY-RUN manually (bypasses launchd, useful for testing):
      HEALTH_DRY_RUN=1 /Users/rai/focused/scripts/health/nightly-health.sh

    REAL manual run (armed mode, bypasses launchd):
      HEALTH_DRY_RUN=0 /Users/rai/focused/scripts/health/nightly-health.sh
    -->
</dict>
</plist>
