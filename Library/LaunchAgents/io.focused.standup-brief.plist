<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.focused.standup-brief</string>

    <!--
    ProgramArguments: invoke the wrapper script via /bin/bash.
    The wrapper loads the whisper token, confirms the session is ready, and
    fires `ark whisper command /standup-brief` into Florence's running session.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rai/focused/scripts/standup-brief/standup-brief.sh</string>
    </array>

    <!--
    StartCalendarInterval: fire Mon-Fri at 09:25 local time (BST in summer),
    20 minutes before the 09:45 daily stand.
    Weekday: 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday.
    launchd skips days when the machine is asleep and catches up on wake; the
    whisper is idempotent enough that a late catch-up is harmless (worst case a
    slightly late brief).
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
    </array>

    <!-- Do NOT fire when launchd loads the plist. The schedule arms it. -->
    <key>RunAtLoad</key>
    <false/>

    <!--
    EnvironmentVariables: launchd provides a minimal environment.
    PATH must include:
      /Users/rai/Library/pnpm    -- the `ark` binary (pnpm global bin)
      /Users/rai/.local/bin      -- rtk, local scripts
      /Users/rai/.asdf/shims     -- node (required by ark)
      /opt/homebrew/bin          -- timeout/gtimeout, curl fallbacks
      /usr/local/bin             -- fallback
      /usr/bin, /bin             -- system tools (curl, tr, date)
    HOME must be explicit (launchd may set it to / or omit it).
    ARK_WORKSPACE_ROOT tells the wrapper which workspace is florence's.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rai</string>
        <key>PATH</key>
        <string>/Users/rai/Library/pnpm:/Users/rai/.local/bin:/Users/rai/.asdf/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>ARK_WORKSPACE_ROOT</key>
        <string>/Users/rai/focused</string>
    </dict>

    <!--
    Log paths: the wrapper also writes its own rolling log to
    scripts/standup-brief/logs/standup-brief.log. These plist-level logs
    capture the wrapper shell's own stdout/stderr as a secondary surface.
    -->
    <key>StandardOutPath</key>
    <string>/Users/rai/focused/scripts/standup-brief/logs/standup-brief-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rai/focused/scripts/standup-brief/logs/standup-brief-launchd-error.log</string>

    <!--
    ARM (to start the Mon-Fri 09:25 schedule):
      chezmoi apply ~/Library/LaunchAgents/io.focused.standup-brief.plist
      launchctl load ~/Library/LaunchAgents/io.focused.standup-brief.plist

    DISARM (stop the schedule without removing the file):
      launchctl unload ~/Library/LaunchAgents/io.focused.standup-brief.plist

    VERIFY (after arming):
      launchctl list | grep standup-brief

    MANUAL RUN (one-shot, does not affect the schedule):
      launchctl start io.focused.standup-brief

    DRY-RUN manually (bypasses launchd, does not whisper):
      STANDUP_DRY_RUN=1 /Users/rai/focused/scripts/standup-brief/standup-brief.sh

    REAL manual run (bypasses launchd, actually whispers):
      /Users/rai/focused/scripts/standup-brief/standup-brief.sh
    -->
</dict>
</plist>
