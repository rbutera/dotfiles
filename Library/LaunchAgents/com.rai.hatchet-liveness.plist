<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rai.hatchet-liveness</string>

    <!-- Alarms when Hatchet 127.0.0.1:17077 refuses connections (bead
         workspace-v2bfn). launchd, not an Impulse job: Impulse is scheduled
         BY Hatchet, so it cannot watch Hatchet. zsh -lc resolves node via the
         login PATH so the plist is not coupled to an asdf version. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec node /Users/rai/navi/bin/hatchet-liveness.mjs</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Logs stay on the internal disk: launchd cannot open a log path on
         the ExternalNVMe (EX_CONFIG 78). -->
    <key>StandardOutPath</key>
    <string>/Users/rai/navi/logs/hatchet-liveness.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rai/navi/logs/hatchet-liveness.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/rai/navi</string>
</dict>
</plist>
