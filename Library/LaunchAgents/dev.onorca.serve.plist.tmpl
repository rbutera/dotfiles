<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.onorca.serve</string>
	<!--
	  Headless Orca runtime server (Remote Orca Server), started at login so this
	  host is always reachable as an Orca execution target from latios/lancelot/phone.

	  Runs the orca binary DIRECTLY (no login/interactive shell). A login zsh was
	  tried first to inherit the full shell env, but Rai's .zprofile/.zshenv fire
	  powerlevel10k's instant prompt in the no-tty launchd context (zle errors that
	  mangle the command), and TERM=dumb can't suppress it because the dotfiles reset
	  TERM before p10k runs. So we exec orca directly with an explicit PATH instead
	  (same pattern as the working com.chaching.nightly-freeze agent). orca is a
	  self-contained Electron app; it only needs HOME + a PATH good enough for the
	  agent CLIs (claude/codex/git) it launches.

	  Pairing address = the machine's Tailscale MagicDNS name. .local is trimmed
	  defensively because nimbus sometimes reports nimbus.local.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/orca</string>
		<string>serve</string>
		<string>--port</string>
		<string>6768</string>
		<string>--pairing-address</string>
		<string>{{ .chezmoi.hostname | trimSuffix ".local" }}.piranha-wyvern.ts.net</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{ .chezmoi.homeDir }}</string>
		<key>PATH</key>
		<string>{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/bin:{{ .chezmoi.homeDir }}/Library/pnpm:{{ .chezmoi.homeDir }}/.asdf/shims:{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin:/opt/homebrew/sbin{{ else }}/usr/local/bin:/usr/local/sbin{{ end }}:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/orca-serve.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/orca-serve.log</string>
</dict>
</plist>
