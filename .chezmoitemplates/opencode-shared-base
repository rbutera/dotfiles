{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zai-anthropic": {
      "api": "anthropic",
      "env": ["ZAI_API_KEY"],
      "models": {
        "glm-5": { "name": "glm-5" },
        "glm-4.7": { "name": "glm-4.7" }
      },
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic"
      }
    }
  },
  "mcp": {
    "camofox": {
      "type": "local",
      "command": ["npx", "-y", "camofox-mcp@latest"],
      "environment": { "CAMOFOX_USER": "opencode" },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?enableAdvancedSearch=true",
      "headers": { "x-api-key": "{env:EXA_API_KEY}" },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "environment": { "MOBILEMCP_DISABLE_TELEMETRY": "1" },
      "enabled": true
    },
    "cua-driver": {
      "type": "local",
      "command": ["uvx", "cua-driver", "mcp"],
      "enabled": true
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "lsp": true
}
