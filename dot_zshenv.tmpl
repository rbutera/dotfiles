#
# Defines environment variables.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# ── Locale ────────────────────────────────────────────────────────────────────
export LANG="en_GB.UTF-8"

# ── Editors & pagers ─────────────────────────────────────────────────────────
{{- $nvim := printf "%s/.local/share/bob/nvim-bin/nvim" .chezmoi.homeDir }}
export EDITOR={{ $nvim | quote }}
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"
export PAGER='less'
export LESS='-g -i -M -R -S -w -X -z-4'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ── PATH ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.asdf/shims:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{ else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end -}}
export PATH="$PNPM_HOME:$PATH"

{{- if eq .chezmoi.os "linux" }}
{{- if or (eq .chezmoi.osRelease.id "arch") (and (hasKey .chezmoi.osRelease "idLike") (eq .chezmoi.osRelease.idLike "arch")) }}
export PATH="/usr/lib/ccache/bin/:$PATH"
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "linux") .wsl }}
export PATH="$PATH:/mnt/c/Windows/System32:/mnt/c/Windows/System32/WindowsPowerShell/v1.0"
{{- end }}

# ── Platform-specific ─────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
export BROWSER='open'
{{- end }}

{{- if eq .chezmoi.os "linux" }}
export COLORTERM=fullcolor
export XDG_CONFIG_HOME="$HOME/.config"
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{- if or (eq .chezmoi.osRelease.id "arch") (and (hasKey .chezmoi.osRelease "idLike") (eq .chezmoi.osRelease.idLike "arch")) }}
export MOZ_ENABLE_WAYLAND=1
export XDG_DATA_DIRS="$XDG_DATA_DIRS:/var/lib/flatpak/exports/share"
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "linux") .wsl }}
export BROWSER='wslview'
{{- end }}

# ── 1Password account selection ───────────────────────────────────────────────
# Two accounts are signed in (personal + Focused Labs), so `op` refuses to guess
# and errors "multiple accounts found" — which breaks every onepasswordRead in a
# chezmoi template. Select by USER ID, not the `personal` shorthand: shorthands
# only exist on machines where the account was added via `op account add`, and
# that command is disabled while the CLI is connected to the 1Password app.
# The user ID is the same account identifier on every machine.
export OP_ACCOUNT=RTBK7UHJFNF7FB7ELCPJRRLDGM # rai@rbutera.com / my.1password.com

# ── SSH session overrides ─────────────────────────────────────────────────────
if [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_TTY:-}" ]; then
  export OP_BIOMETRIC_UNLOCK_ENABLED=false
fi

# ── Tool config ──────────────────────────────────────────────────────────────
export FZF_DEFAULT_OPTS="--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
export CHEZMOI_DIR="$HOME/.local/share/chezmoi"
export SDKMAN_DIR="$HOME/.sdkman"
export SSH_ASKPASS=""
export GIT_TERMINAL_PROMPT=0
export OPENSPEC_TELEMETRY=0

# ── Ark ──────────────────────────────────────────────────────────────────────
{{- if has .chezmoi.hostname .host_groups.work }}
export ARK_WORKSPACE="$HOME/focused"
{{- else }}
export ARK_WORKSPACE="$HOME/navi"
{{- end }}

# ── Claude Code ──────────────────────────────────────────────────────────────
{{- if has .chezmoi.hostname .host_groups.work }}
export ANTHROPIC_DEFAULT_OPUS_MODEL='claude-opus-4-8'
{{- else }}
export ANTHROPIC_DEFAULT_OPUS_MODEL='claude-opus-4-8'
{{- end }}
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# ── Runtime environments ─────────────────────────────────────────────────────
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

# https://viteplus.dev — sourced here (not just .zshrc) so IDE / non-interactive
# shells also get vp on PATH. Node management is in system-first mode
# (`vp env off`), so node/npm still resolve via asdf.
[[ -s "$HOME/.vite-plus/env" ]] && . "$HOME/.vite-plus/env"

# ═════════════════════════════════════════════════════════════════════════════
# Secrets (1Password) — sourced group files under ~/.config/zsh/
# ═════════════════════════════════════════════════════════════════════════════
#
# Secrets used to live inline here (~70 onepasswordRead calls = ~70 `op read`
# round-trips on every `chezmoi apply`). They now live in per-domain group files
# (chezmoi source: dot_config/zsh/*.zsh.tmpl → deployed: ~/.config/zsh/*.zsh),
# each rendered with whole-item caching (onepasswordDetailsFields) so a multi-
# field item is fetched ONCE, not once per field.
#
# Why this is faster to APPLY (not faster at shell startup — startup was already
# ~0ms): `chezmoi apply ~/.config/zsh/<group>.zsh` renders only that one group,
# so editing one key re-reads only that group's items, not all ~70. Bulk apply
# also collapses dup/multi-field items (discord 14→1, easyjet-jira 9→1, etc.).
#
# This structural .zshenv contains NO onepasswordRead calls, so
# `chezmoi apply ~/.zshenv` never invokes 1Password.
#
# Sourcing every group keeps .zshenv behaviour identical to the old inline block
# (these are exported for every zsh, including non-interactive shells/scripts).
if [ -d "$HOME/.config/zsh" ]; then
  for __zsh_group in "$HOME"/.config/zsh/*.zsh(N); do
    [ -r "$__zsh_group" ] && source "$__zsh_group"
  done
  unset __zsh_group
fi
