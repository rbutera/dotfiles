# flaude: start a Claude Code session in ~/focused that reuses Florence's config
# WITHOUT the Ark runtime or the Discord/voice/email channel plugins.
# cwd=~/focused already auto-loads CLAUDE.md + project skills + project MCP + bd hooks;
# this just adds the Florence persona/brain. unset token = use interactive login creds.
flaude() {
  local brain="$HOME/dev/lumiere/apps/ark/plugin/agents/florence.md"
  cd ~/focused && unset CLAUDE_CODE_OAUTH_TOKEN
  if [ -f "$brain" ]; then
    command claude --dangerously-skip-permissions --append-system-prompt-file "$brain" "$@"
  else
    echo "flaude: brain not found at $brain, launching plain claude" >&2
    command claude --dangerously-skip-permissions "$@"
  fi
}
florence() { flaude "$@"; }
