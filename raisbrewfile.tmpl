tap "github/gh"
tap "homebrew/services"

{{ if eq .chezmoi.os "darwin" }}
# macOS-specific
brew "gnu-sed"
brew "coreutils"
brew "mpv"
brew "gcc"
brew "reattach-to-user-namespace"

# Fonts
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono-nerd-font"

{{ if has .chezmoi.hostname .host_groups.work }}
# Docker (Colima-backed — work machines only). `DOCKER_HOST` in
# dot_zshenv.tmpl already points at ~/.colima/default/docker.sock.
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
{{ end }}
{{ end }}

# Core CLI tools
brew "bat"
brew "curl"
brew "eza"
brew "fd"
brew "fzf"
brew "git"
brew "git-delta"
brew "git-lfs"
brew "htop"
brew "jq"
brew "yq"
brew "ripgrep"
brew "starship"
brew "tldr"
brew "tmux"
brew "tree"
brew "wget"
brew "zsh"
brew "zsh-completions"

# Modern replacements
brew "zoxide"
brew "lazygit"

# GitHub
brew "gh"

# Version management
brew "asdf"

# Development
brew "shellcheck"
brew "stylua"
brew "gnupg"
brew "openssl@3"
brew "readline"
brew "mkcert"

{{ if eq .chezmoi.os "linux" }}
# Linux-specific
brew "keychain"
{{ end }}
