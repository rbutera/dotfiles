{{- $home := .chezmoi.homeDir -}}
{{- $outputDir := joinPath $home "dev" "lumiere" "apps" "chronicler" "output" -}}
{{- $inputPath := joinPath $home "dev" "transcripts" "navi.json" -}}
{{- $pluginRoot := joinPath $home "navi" -}}
{{- $workspace := joinPath $pluginRoot "workspace" -}}
{{- $naviAgentFile := joinPath $home "dev" "lumiere" "apps" "ark" "plugin" "agents" "navi.md" -}}
{{- $agentSummaryContextFiles := list
  $naviAgentFile
  (joinPath $pluginRoot "USER.md")
  (joinPath $workspace "memory" "continuity-anchor.md")
  (joinPath $workspace "memory" "love-anchor.md")
-}}
{{- $summaryContextFiles := list
  $naviAgentFile
  (joinPath $pluginRoot "USER.md")
  (joinPath $workspace "memory" "continuity-anchor.md")
-}}
{{- dict
  "defaultAgent" "navi"
  "agents" (dict
    "navi" (dict
      "channelId" "1473760382387621950"
      "inputPath" $inputPath
      "outputDir" $outputDir
      "summaryContextFiles" $agentSummaryContextFiles
    )
  )
  "inputPath" $inputPath
  "model" "openai-codex/gpt-5.4"
  "apiFormat" "chat-completions"
  "timezone" "Europe/London"
  "concurrency" 5
  "promptVersion" "1"
  "adminBulletsMin" 2
  "adminBulletsMax" 20
  "maxDayChars" 40000
  "topicMaxInputChars" 500000
  "verbose" true
  "failFast" false
  "outputDir" $outputDir
  "exportDefaultDirectory" (joinPath $home "dev" "transcripts")
  "summaryContextFiles" $summaryContextFiles
| toPrettyJson -}}
