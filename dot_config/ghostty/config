command = /usr/bin/zsh

# ── Theme ──────────────────────────────────────────────────────────────────────
theme = Catppuccin Mocha

# ── Font ───────────────────────────────────────────────────────────────────────
font-size = 8
# JetBrains Mono (built-in) with ligatures on by default

# ── Window ─────────────────────────────────────────────────────────────────────
window-padding-x = 4
window-padding-y = 4
window-padding-color = extend

# Use Ghostty's own titlebar/tab styling instead of GTK's
window-theme = ghostty
# Match the titlebar to Catppuccin Mocha base/text colors
window-titlebar-background = 1e1e2e
window-titlebar-foreground = cdd6f4
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-custom-css = style.css

# ── Background ────────────────────────────────────────────────────────────
background-opacity = 0.95

# ── Cursor ─────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Working directory inheritance ──────────────────────────────────────────────
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# ── Mouse ──────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Notifications ──────────────────────────────────────────────────────────────
# Notify via desktop notification when a command that ran for >10s finishes
# while the window is unfocused. Works on KDE, Hyprland, Niri, etc.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# ── Shell integration ──────────────────────────────────────────────────────────
# Auto-detected for zsh — enables prompt navigation, smart close, CWD passing,
# cursor style changes at prompt, etc. No extra config needed.
