#!/bin/bash
# Modify script for ~/.config/opencode-openagent/oh-my-openagent.json
# (oh-my-openagent model routing for the `openagent` profile)
#
# Strategy: spread across the user's flat subscriptions by leverage/volume.
#   - High-leverage seats (orchestrator/planner/reviewer/deep-worker/oracle + the
#     deep/ultrabrain categories) -> openai/gpt-5.5  (Codex sub, generous, verified).
#   - High-volume grind (executor/junior/utility/frontend) -> OpenCode Go models
#     (kimi-k2.7-code, deepseek-v4-flash, minimax-m3, glm-5.2) — verified working.
#   - Every gpt-5.5 seat has a Go fallback so an exhausted Codex quota spills to Go.
#
# PENDING (needs CURSOR_API_KEY live — `chezmoi apply ~/.zshenv` + fresh shell):
#   sisyphus (orchestrator) -> cursor-acp/claude-4.6-opus  (Cursor Pro; best planner)
#   oracle / multimodal     -> cursor-acp/claude-4.6-opus / gemini-3.1-pro (Cursor)
# Until then sisyphus runs on gpt-5.5 (strong interim orchestrator). See
# docs/opencode-profiles.md.
#
# Managed keys (replaced): $schema, agents, categories, claude_code, runtime_fallback
# Free keys (preserved):   anything else the omo installer/runtime writes
set -euo pipefail

current=$(cat)
[ -z "$current" ] && current='{}'

read -r -d '' base << 'BASE' || true
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus":   { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" }, { "model": "opencode-go/glm-5.2" } ] },
    "prometheus": { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "metis":      { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "momus":      { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "hephaestus": { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/glm-5.2" }, { "model": "opencode-go/kimi-k2.7-code" } ] },
    "oracle":     { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "atlas":      { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/kimi-k2.7-code" }, { "model": "opencode-go/minimax-m3" } ] },
    "sisyphus-junior": { "model": "opencode-go/deepseek-v4-flash", "fallback_models": [ { "model": "opencode-go/minimax-m3" } ] },
    "librarian":  { "model": "opencode-go/minimax-m3", "fallback_models": [ { "model": "opencode-go/minimax-m2.7" } ] },
    "explore":    { "model": "opencode-go/deepseek-v4-flash", "fallback_models": [ { "model": "opencode-go/minimax-m3" } ] },
    "multimodal-looker": { "model": "opencode-go/minimax-m3", "fallback_models": [ { "model": "opencode-go/kimi-k2.6" } ] }
  },
  "categories": {
    "ultrabrain":         { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "deep":               { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] },
    "quick":              { "model": "opencode-go/deepseek-v4-flash", "fallback_models": [ { "model": "opencode-go/minimax-m3" } ] },
    "visual-engineering": { "model": "opencode-go/glm-5.2" },
    "artistry":           { "model": "opencode-go/glm-5.2" },
    "writing":            { "model": "opencode-go/glm-5.2", "fallback_models": [ { "model": "opencode-go/kimi-k2.7-code" } ] },
    "unspecified-low":    { "model": "opencode-go/minimax-m3", "fallback_models": [ { "model": "opencode-go/deepseek-v4-flash" } ] },
    "unspecified-high":   { "model": "openai/gpt-5.5", "fallback_models": [ { "model": "opencode-go/deepseek-v4-pro" } ] }
  },
  "claude_code": {
    "mcp": false,
    "commands": false,
    "skills": false,
    "agents": false,
    "hooks": false,
    "plugins": false
  },
  "runtime_fallback": true
}
BASE

echo "$current" | jq --argjson base "$base" '
  . as $current |
  $base * ($current | del(."$schema", .agents, .categories, .claude_code, .runtime_fallback))
'
