{
  "environment": "{{ .chezmoi.hostname }}",
  "timezone": "Europe/London",
  "paths": {
{{- if has .chezmoi.hostname .host_groups.work }}
    "workspaceRoot": "{{ .chezmoi.homeDir }}/tilly",
{{- else }}
    "workspaceRoot": "{{ .chezmoi.homeDir }}/navi",
{{- end }}
    "repoRoot": "{{ .chezmoi.homeDir }}/dev/lumiere",
    "stateRoot": "{{ .chezmoi.homeDir }}/.local/state/impulse"
  },
  "hatchet": {
{{- if eq .chezmoi.hostname "nimbus" }}
    "namespace": "navi",
    "workerName": "impulse-nimbus"
{{- else if eq .chezmoi.hostname "latios" }}
    "namespace": "tilly",
    "workerName": "impulse-latios"
{{- else }}
    "namespace": "{{ .chezmoi.hostname }}",
    "workerName": "impulse-{{ .chezmoi.hostname }}"
{{- end }}
  },
{{- if eq .chezmoi.hostname "nimbus" }}
  "capabilities": {
    "cronEnabled": true,
    "sensorsEnabled": true,
    "heartbeatsEnabled": true,
    "narrateQueueEnabled": true,
    "stewardshipEnabled": true,
    "openclawProbeEnabled": true
  }
{{- else if eq .chezmoi.hostname "latios" }}
  "capabilities": {
    "cronEnabled": true,
    "sensorsEnabled": true,
    "heartbeatsEnabled": true,
    "narrateQueueEnabled": false,
    "stewardshipEnabled": false,
    "openclawProbeEnabled": false
  }
{{- else }}
  "capabilities": {
    "cronEnabled": true,
    "sensorsEnabled": true,
    "heartbeatsEnabled": true,
    "narrateQueueEnabled": false,
    "stewardshipEnabled": false,
    "openclawProbeEnabled": false
  }
{{- end }}
}
