{{- if eq .chezmoi.hostname "latios" }}
[
  {
    "id": "quota-scrape",
    "name": "Claude Quota Scrape (active account, every 5m)",
    "trigger": {
      "kind": "cron",
      "expr": "*/5 * * * *",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "script",
      "bin": "node"
    },
    "payload": {
      "kind": "shell",
      "cmd": "node",
      "args": [
        "{{ .chezmoi.homeDir }}/dev/lumiere/libs/claude-quota-scraper/dist/cli.js"
      ]
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": false,
      "dedupe": "skip-if-running"
    },
    "enabled": true,
    "tags": [
      "infrastructure",
      "quota"
    ],
    "inputs": {
      "cmd": "node",
      "args": [
        "{{ .chezmoi.homeDir }}/dev/lumiere/libs/claude-quota-scraper/dist/cli.js"
      ],
      "cwd": "{{ .chezmoi.homeDir }}/dev/lumiere"
    }
  },
  {
    "id": "morning-sweep",
    "name": "Tilly: Morning Sweep (08:30 daily)",
    "trigger": {
      "kind": "cron",
      "expr": "30 8 * * *",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "ark-spawn",
      "agent": "tilly",
      "model": "sonnet"
    },
    "payload": {
      "kind": "prompt",
      "text": "Run /morning-sweep"
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": true,
      "dedupe": "skip-if-running"
    },
    "enabled": true,
    "tags": [
      "work",
      "latios"
    ],
    "inputs": {
      "agent": "tilly",
      "workingDir": "{{ .chezmoi.homeDir }}/tilly",
      "model": "sonnet",
      "maxTurns": 30,
      "prompt": "Run /morning-sweep"
    }
  },
  {
    "id": "todoist-hygiene",
    "name": "Tilly: Todoist Hygiene (triage hourly 08:15-20:15; interactive digest on 08:xx morning run)",
    "trigger": {
      "kind": "cron",
      "expr": "15 8-20 * * *",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "ark-spawn",
      "agent": "tilly",
      "model": "sonnet"
    },
    "payload": {
      "kind": "prompt",
      "text": "Run /todoist-triage in autonomous mode. Then, ONLY on the 08:xx morning run (check `date +%H` == 08), send the interactive digest: `python3 ~/tilly/scripts/todoist/digest.py send`. On later hourly runs do triage only and send NO Discord message. Never send a preamble, 'summary incoming', 'test', or mid-run announcement."
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": true,
      "dedupe": "skip-if-running"
    },
    "enabled": true,
    "tags": [
      "work",
      "latios",
      "todoist"
    ],
    "inputs": {
      "agent": "tilly",
      "workingDir": "{{ .chezmoi.homeDir }}/tilly",
      "model": "sonnet",
      "maxTurns": 25,
      "prompt": "Run /todoist-triage in autonomous mode: apply safe filing (move to the right PARA project, set labels and priority, clear bogus dates) automatically, and queue any closes, graduations, or external actions to vault/research/todoist/<date>-needs-review.md for /morning-sweep to surface. Triage ALSO refreshes today's Todoist snapshot at vault/research/todoist/<date>-snapshot.json, which the digest reads. THEN decide whether to surface: run `date +%H` — if and ONLY if the hour is 08 (the morning run), send the interactive Todoist digest by running the shell command `python3 ~/tilly/scripts/todoist/digest.py send`. That command builds the Components-V2 digest from the fresh snapshot + the loop ledger and POSTs it to the ark-discord daemon at 127.0.0.1:3850/todoist-digest, which DMs Rai the tappable digest (this REPLACES the old plain-text /todoist-review summary DM — do not run /todoist-review or send any plain-text summary yourself). Report the digest.py exit status. On any hourly run where the hour is NOT 08, do the triage filing only and send NO Discord message at all. If digest.py reports the daemon is unreachable or returns non-200 (e.g. the /todoist-digest route is not yet deployed), do NOT fall back to a plain-text DM — instead log the failure to vault/research/todoist/<date>-needs-review.md and send NO message. Never send any preamble, placeholder, 'summary incoming', 'test', 'heads up', or mid-run announcement message under any circumstances."
    }
  },
  {
    "id": "lamplight-incremental",
    "name": "Lamplight: Incremental Update (hourly, business hours)",
    "trigger": {
      "kind": "cron",
      "expr": "0 8-19 * * 1-5",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "script",
      "bin": "pnpm"
    },
    "payload": {
      "kind": "shell",
      "cmd": "pnpm",
      "args": [
        "nx",
        "run",
        "lamplight:dev",
        "--",
        "breadcrumb",
        "--date",
        "today",
        "--incremental"
      ]
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": false,
      "dedupe": "skip-if-running"
    },
    "enabled": true,
    "tags": [
      "work",
      "latios",
      "lamplight"
    ],
    "inputs": {
      "cmd": "pnpm",
      "args": [
        "nx",
        "run",
        "lamplight:dev",
        "--",
        "breadcrumb",
        "--date",
        "today",
        "--incremental"
      ],
      "cwd": "{{ .chezmoi.homeDir }}/dev/lumiere"
    }
  },
  {
    "id": "lamplight-nightly",
    "name": "Lamplight: Nightly Full Digest (21:00)",
    "trigger": {
      "kind": "cron",
      "expr": "0 21 * * *",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "script",
      "bin": "pnpm"
    },
    "payload": {
      "kind": "shell",
      "cmd": "pnpm",
      "args": [
        "nx",
        "run",
        "lamplight:dev",
        "--",
        "all",
        "--date",
        "today"
      ]
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": false,
      "dedupe": "skip-if-running"
    },
    "enabled": true,
    "tags": [
      "work",
      "latios",
      "lamplight"
    ],
    "inputs": {
      "cmd": "pnpm",
      "args": [
        "nx",
        "run",
        "lamplight:dev",
        "--",
        "all",
        "--date",
        "today"
      ],
      "cwd": "{{ .chezmoi.homeDir }}/dev/lumiere"
    }
  },
  {
    "id": "daily-blog",
    "name": "Tilly: Daily Blog (21:30 nightly, weekday=work+topic / weekend=wild)",
    "trigger": {
      "kind": "cron",
      "expr": "30 21 * * *",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "ark-spawn",
      "agent": "tilly",
      "model": "opus"
    },
    "payload": {
      "kind": "prompt",
      "text": "Read ~/tilly/.claude/skills/daily-blog/SKILL.md and follow it. Pick the mode by day of week (weekday-post Mon-Fri, weekend-post Sat-Sun). Write today's post and DM it to Rai."
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": true,
      "dedupe": "skip-if-running",
      "timeout": 2700
    },
    "enabled": true,
    "tags": [
      "work",
      "latios",
      "blog"
    ],
    "promptFile": "prompts/florence-daily-blog.md",
    "inputs": {
      "agent": "tilly",
      "workingDir": "{{ .chezmoi.homeDir }}/tilly",
      "model": "opus",
      "maxTurns": 40,
      "prompt": "Read ~/tilly/.claude/skills/daily-blog/SKILL.md and follow it as the source of truth, reading the reference docs your mode requires. Read ~/dev/lumiere/apps/ark/plugin/agents/tilly.md for voice. Pick the mode by day of week per the skill's Step 0 (run `date +%u`): Monday-Friday is weekday-post (the work plus one researched topic), Saturday-Sunday is weekend-post (personal / wild). Read the day's material (today's breadcrumb, the lamplight Daily summary, recent session transcripts) and the last 5-7 prior posts in ~/tilly/vault/Blog/ for voice continuity, and do the dedup-title check. Write the post to ~/tilly/vault/Blog/{date} {Title}.md with the frontmatter the skill specifies, then DM it to Rai on Discord (chat_id 1499031021746913341). If an exact Rai quote cannot be recovered, omit it rather than invent one. No em dashes. Internal audience only."
    }
  }
]
