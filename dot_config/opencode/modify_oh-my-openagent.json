#!/bin/bash
# Modify script for ~/.config/opencode/oh-my-openagent.json
# Merges managed config into existing oh-my-openagent settings.
# Managed: skills, disabled_hooks, git_master, agents, categories
# Free: _migrations (runtime state added by the tool)
set -euo pipefail

current=$(cat)
[ -z "$current" ] && current='{}'

read -r -d '' base << 'BASE' || true
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "skills": {
    "disable": [
      "using-superpowers",
      "superpowers:using-superpowers",
      "superpowers:systematic-debugging",
      "superpowers:writing-skills",
      "superpowers:requesting-code-review",
      "superpowers:finishing-a-development-branch",
      "superpowers:writing-plans",
      "superpowers:brainstorming",
      "superpowers:receiving-code-review",
      "superpowers:verification-before-completion",
      "superpowers:subagent-driven-development",
      "superpowers:test-driven-development",
      "superpowers:executing-plans",
      "superpowers:using-git-worktrees",
      "superpowers:dispatching-parallel-agents"
    ]
  },
  "disabled_hooks": [
    "anthropic-context-window-limit-recovery",
    "no-sisyphus-gpt"
  ],
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "agents": {
    "sisyphus": { "model": "openai/gpt-5.4", "variant": "high" },
    "hephaestus": { "model": "openai/gpt-5.4", "variant": "medium" },
    "oracle": { "model": "openai/gpt-5.4", "variant": "high" },
    "librarian": { "model": "openai/gpt-5.2" },
    "explore": { "model": "openai/gpt-5.2", "variant": "off" },
    "multimodal-looker": { "model": "openai/gpt-5.4", "variant": "medium" },
    "prometheus": { "model": "openai/gpt-5.4", "variant": "high" },
    "metis": { "model": "openai/gpt-5.4", "variant": "high" },
    "momus": { "model": "openai/gpt-5.4", "variant": "xhigh" },
    "atlas": { "model": "openai/gpt-5.4", "variant": "medium" }
  },
  "categories": {
    "visual-engineering": { "model": "openai/gpt-5.2" },
    "ultrabrain": { "model": "openai/gpt-5.4", "variant": "xhigh" },
    "deep": { "model": "openai/gpt-5.4", "variant": "medium" },
    "quick": { "model": "openai/gpt-5.4", "variant": "low" },
    "unspecified-low": { "model": "openai/gpt-5.4", "variant": "medium" },
    "unspecified-high": { "model": "openai/gpt-5.4", "variant": "medium" },
    "writing": { "model": "openai/gpt-5.4", "variant": "low" }
  }
}
BASE

# Replace managed keys from base, preserve free keys (_migrations, etc.)
echo "$current" | jq --argjson base "$base" '
  . as $cur |
  $base + (if $cur._migrations then {_migrations: $cur._migrations} else {} end)
'
