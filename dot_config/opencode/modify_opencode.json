#!/bin/bash
# Modify script for ~/.config/opencode/opencode.json
# Merges managed config into existing opencode settings.
# Managed: provider, mcp, skills, plugin, agent, lsp
# Free: everything else (future runtime state)
set -euo pipefail

current=$(cat)
[ -z "$current" ] && current='{}'

read -r -d '' base << 'BASE' || true
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zai-anthropic": {
      "api": "anthropic",
      "env": ["ZAI_API_KEY"],
      "models": {
        "glm-5": { "name": "glm-5" },
        "glm-4.7": { "name": "glm-4.7" }
      },
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic"
      }
    }
  },
  "mcp": {
    "camofox": {
      "type": "local",
      "command": ["npx", "-y", "camofox-mcp@latest"],
      "environment": { "CAMOFOX_USER": "opencode" },
      "enabled": true
    }
  },
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "plugin": ["oh-my-opencode-slim"],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "lsp": true
}
BASE

# Replace managed keys from base, preserve any unknown runtime keys
echo "$current" | jq --argjson base "$base" '
  . as $current |
  $base * ($current | del(.provider, .mcp, .skills, .plugin, .agent, .lsp, ."$schema"))
'
