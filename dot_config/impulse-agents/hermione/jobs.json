[
  {
    "id": "hermione-weekly-digest",
    "name": "Hermione: weekly culture digest (Sun 07:30 London)",
    "trigger": {
      "kind": "cron",
      "expr": "30 7 * * 0",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "ark-spawn",
      "agent": "hermione",
      "model": "claude-opus-5-5"
    },
    "payload": {
      "kind": "prompt",
      "text": "Hermione: weekly culture digest (Sun 07:30 London)"
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": true,
      "dedupe": "skip-if-running",
      "timeout": 1800
    },
    "enabled": true,
    "tags": [
      "culture",
      "hermione",
      "latios"
    ],
    "promptFile": "prompts/weekly-digest.md",
    "inputs": {
      "agent": "hermione",
      "workingDir": "/Users/rai/hermione",
      "model": "claude-opus-5-5",
      "maxTurns": 150
    }
  },
  {
    "id": "hermione-digest-catchup",
    "name": "Hermione: digest catch-up if Sunday's was missed (Mon 07:30 London)",
    "trigger": {
      "kind": "cron",
      "expr": "30 7 * * 1",
      "tz": "Europe/London"
    },
    "target": {
      "kind": "ark-spawn",
      "agent": "hermione",
      "model": "sonnet"
    },
    "payload": {
      "kind": "prompt",
      "text": "Hermione: digest catch-up if Sunday's was missed (Mon 07:30 London)"
    },
    "policy": {
      "maxConcurrent": 1,
      "quotaAware": true,
      "dedupe": "skip-if-running",
      "timeout": 1800
    },
    "enabled": true,
    "tags": [
      "culture",
      "hermione",
      "latios"
    ],
    "promptFile": "prompts/digest-catchup.md",
    "inputs": {
      "agent": "hermione",
      "workingDir": "/Users/rai/hermione",
      "model": "sonnet",
      "maxTurns": 150
    }
  }
]
