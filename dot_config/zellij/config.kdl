// Zellij config — Rai Butera
// Ported from tmux workflow on 2026-04-09
//
// tmux prefix was C-Space (secondary) / C-b (primary).
// Zellij uses modal keybinds instead of prefix keys.
// The approach: keep muscle memory where possible, use Zellij's modal
// system for everything else.
//
// Docs: https://zellij.dev/documentation/

// -- Core options --
theme "catppuccin-mocha"
default_shell "zsh"
default_layout "default"
default_mode "normal"
pane_frames false
mouse_mode true
copy_on_select true
copy_clipboard "system"
scroll_buffer_size 10000
on_force_close "detach"
simplified_ui false
session_serialization true
auto_layout true
styled_underlines true
rounded_corners true
osc8_hyperlinks true
support_kitty_keyboard_protocol true

// Mirror tmux: start numbering at 1 (Zellij doesn't have this option
// natively but the default layout can be configured)

// -- Environment --
env {
    // Inherit EDITOR for scrollback editing
}

// -- Plugins (WASM, loaded from URLs on first use) --
plugins {
    // Monocle: fuzzy file/content finder (like fzf in tmux)
    monocle location="https://github.com/imsnif/monocle/releases/latest/download/monocle.wasm"

    // Harpoon: quick pane navigation (ThePrimeagen-style)
    // NOTE: must be built from source, see install instructions below
    // harpoon location="file:/Users/rai/.config/zellij/plugins/harpoon.wasm"

    // zellij-forgot: keybind reminder / cheatsheet
    forgot location="https://github.com/karimould/zellij-forgot/releases/latest/download/zellij_forgot.wasm"

    // zellij-attention: notification icons on tabs
    // NOTE: must be downloaded from releases
    // attention location="file:/Users/rai/.config/zellij/plugins/zellij-attention.wasm"

    // zellij-worktree: git worktree management
    worktree location="https://github.com/sharph/zellij-worktree/releases/latest/download/zellij-worktree.wasm"
}

// -- Load background plugins --
// Uncomment after installing the plugins locally
// load_plugins {
//     "file:/Users/rai/.config/zellij/plugins/zellij-attention.wasm" {
//         enabled "true"
//         waiting_icon "⏳"
//         completed_icon "✅"
//     }
// }

// ============================================================
// Keybindings
// ============================================================
// Design principles:
//   - Ctrl+Space enters "tmux mode" (mapped to Pane mode) for pane ops
//   - h/j/k/l navigation everywhere (matching tmux and vim)
//   - Tab/Shift-Tab for window (tab) switching (matching tmux Tab)
//   - Minimal mode switching; stay in Normal as much as possible
//
// tmux → Zellij mapping:
//   tmux prefix + -     → split horizontal  → Alt+- (Normal)
//   tmux prefix + _     → split vertical    → Alt+_ (Normal)
//   tmux prefix + h/j/k/l → move pane       → Alt+h/j/k/l (Normal)
//   tmux prefix + H/J/K/L → resize pane     → Alt+r mode + h/j/k/l
//   tmux prefix + z     → zoom pane         → Alt+f (Normal)
//   tmux prefix + c     → new window        → Alt+t (Normal, new tab)
//   tmux prefix + n/p   → next/prev window  → Alt+]/Alt+[ (Normal)
//   tmux prefix + Tab   → last window       → Alt+Tab (Normal)
//   tmux prefix + x     → close pane        → Alt+x (Normal)
//   tmux prefix + d     → detach            → Ctrl+/ d (Session mode)
//   tmux prefix + Enter → copy mode         → Alt+s (Scroll mode)
//   tmux prefix + [     → scroll up         → Alt+s (Scroll mode)
//
// Vim-safe: Ctrl+r (redo), Ctrl+o (jumplist), Ctrl+f (pagedown),
//           Ctrl+s (save), Ctrl+t (tagstack), Ctrl+p (completion)
//           are all passed through to the terminal app.
// ============================================================

keybinds clear-defaults=true {

    // -- Normal mode --
    // Most operations accessible without mode switching
    normal {
        // Mode switching
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt s" { SwitchToMode "scroll"; }
        bind "Ctrl /" { SwitchToMode "session"; }
        bind "Alt r" { SwitchToMode "resize"; }
        bind "Alt e" { SwitchToMode "tab"; }
        bind "Ctrl Space" { SwitchToMode "pane"; }

        // Pane creation — direct from Normal (matches tmux - and _)
        bind "Alt -" { NewPane "Down"; }
        bind "Alt _" { NewPane "Right"; }
        bind "Alt =" { NewPane "Right"; }

        // Pane navigation — direct from Normal (matches tmux h/j/k/l)
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }

        // Pane zoom/fullscreen (matches tmux prefix+z)
        bind "Alt f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Floating pane toggle
        bind "Alt w" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // Tab (window) operations — direct from Normal
        bind "Alt t" { NewTab; }
        bind "Alt x" { CloseFocus; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt Tab" { ToggleTab; }

        // Direct tab access (Alt+1..9, like tmux prefix+1..9)
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // Layout cycling
        bind "Alt Space" { NextSwapLayout; }

        // Monocle fuzzy finder (replaces fzf-in-tmux workflow)
        bind "Alt m" {
            LaunchPlugin "monocle" {
                in_place true
                kiosk true
            };
            SwitchToMode "Normal";
        }
        bind "Ctrl `" {
            LaunchOrFocusPlugin "monocle" {
                floating true
            };
            SwitchToMode "Normal";
        }

        // Git worktree manager
        bind "Alt g" {
            LaunchOrFocusPlugin "worktree" {
                floating true
            };
            SwitchToMode "Normal";
        }

        // Harpoon — quick pane bookmarks (uncomment after installing)
        // bind "Alt y" {
        //     LaunchOrFocusPlugin "file:/Users/rai/.config/zellij/plugins/harpoon.wasm" {
        //         floating true
        //         move_to_focused_tab true
        //     };
        // }

        // Keybind reminder
        bind "Alt /" {
            LaunchOrFocusPlugin "https://github.com/karimould/zellij-forgot/releases/latest/download/zellij_forgot.wasm" {
                "LOAD_ZELLIJ_BINDINGS" "true"
                floating true
            };
        }
    }

    // -- Locked mode --
    // Only way out is Ctrl+g (prevents accidental commands)
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // -- Pane mode --
    // Entered via Ctrl+Space (like tmux prefix)
    // Single keystrokes for pane operations, then back to Normal
    pane {
        bind "Ctrl Space" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }

        // Navigation (h/j/k/l like tmux)
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // Split (- horizontal, _ vertical, like tmux)
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "_" { NewPane "Right"; SwitchToMode "Normal"; }

        // Pane operations
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "f" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }

        // Rename pane (like tmux prefix+,)
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }

        // Swap panes (< and > like tmux)
        bind "<" { MovePane "Left"; SwitchToMode "Normal"; }
        bind ">" { MovePane "Right"; SwitchToMode "Normal"; }

        // Tab key for switching focus
        bind "Tab" { SwitchFocus; SwitchToMode "Normal"; }
    }

    // -- Tab mode --
    // Entered via Alt+e (frees Ctrl+t for vim tag stack)
    tab {
        bind "Alt e" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }

        // Navigation
        bind "h" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }
        bind "j" { GoToNextTab; }
        bind "k" { GoToPreviousTab; }

        // Tab operations
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }

        // Break pane into new tab (like tmux break-pane)
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }

        // Direct tab access
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Move tab position
        bind "Tab" { ToggleTab; }
    }

    // -- Resize mode --
    // Entered via Alt+r (frees Ctrl+r for vim redo)
    resize {
        bind "Alt r" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }

        // h/j/k/l for resize (matches tmux H/J/K/L resize behavior)
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }

        // Shift for decrease
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }

        // +/- for general resize
        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // -- Scroll mode --
    // Entered via Alt+s (frees Ctrl+s for vim/Neovim save)
    scroll {
        bind "Alt s" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
        bind "q" { SwitchToMode "Normal"; }

        // vi-style scrolling (matches tmux copy-mode-vi)
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "f" { PageScrollDown; }
        bind "b" { PageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "g" { ScrollToTop; }

        // Enter search mode
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }

        // Edit scrollback in $EDITOR (powerful replacement for tmux capture-pane)
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
    }

    // -- Search mode --
    search {
        bind "Alt s" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }

        bind "n" { Search "down"; }
        bind "N" { Search "up"; }

        // Toggle search options
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "WholeWord"; }
        bind "r" { SearchToggleOption "Wrap"; }

        // Scrolling while searching
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }

    // -- Enter search mode --
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }

    // -- Session mode --
    // Entered via Ctrl+/ (frees Ctrl+o for vim jump list back)
    session {
        bind "Ctrl /" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }

        // Detach (like tmux prefix+d)
        bind "d" { Detach; }

        // Quit Zellij entirely
        bind "q" { Quit; }
    }

    // -- Rename tab --
    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "tab"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // -- Rename pane --
    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "pane"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // -- Shared bindings (available in all non-locked modes) --
    shared_except "locked" {
        // Quick mode toggles that work from any mode
        bind "Alt n" { NewPane; }
        bind "Alt q" { CloseFocus; }

        // Mouse support for pane focus
        // (mouse_mode true handles this globally)
    }
}
