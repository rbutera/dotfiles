// Default layout — Rai Butera
// Clean single-pane layout with compact status bar.
// Mirrors the tmux experience: one pane, split as needed.

layout {
    // Main editing area
    pane

    // Status bar — shows current mode and contextual keybind hints
    // Switch back to compact-bar (size=1) once comfortable with keybinds
    pane size=2 borderless=true {
        plugin location="status-bar"
    }
}
