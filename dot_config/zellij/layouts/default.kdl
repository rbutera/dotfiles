// Default layout — reset to zellij's built-in OOTB default on 2026-07-04.
// tab-bar on top, your pane in the middle, and the full status-bar at the bottom
// (the one that shows the current mode + its keybind hints) — that hint bar is the
// main way to learn the default keybindings, so it stays.
layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
