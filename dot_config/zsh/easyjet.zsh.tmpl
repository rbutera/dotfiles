# ── Secrets group: easyJet / Atlassian / SonarQube (work hosts only) ───────────
# Sourced by ~/.zshenv via the secrets loader. chezmoi-managed (.tmpl).
# Apply just this group:  chezmoi apply ~/.config/zsh/easyjet.zsh
#
# Whole block is gated to work hosts; on non-work hosts this file renders to just
# the header comment and exports nothing (and runs zero op reads).
{{- if has .chezmoi.hostname .host_groups.work }}

# EasyJet JIRA API — nine env vars across ATLASSIAN / JIRA / CONFLUENCE, three
# distinct fields (credential / username / hostname) of ONE item → one fetch.
{{- $jira := onepasswordDetailsFields "EasyJet JIRA API" "focused" }}
export ATLASSIAN_API_KEY={{ $jira.credential.value | quote }}
export ATLASSIAN_EMAIL={{ $jira.username.value | quote }}
export ATLASSIAN_BASE_URL={{ $jira.hostname.value | quote }}

export JIRA_API_TOKEN={{ $jira.credential.value | quote }}
export JIRA_USERNAME={{ $jira.username.value | quote }}
export JIRA_URL={{ $jira.hostname.value | quote }}

export CONFLUENCE_API_TOKEN={{ $jira.credential.value | quote }}
export CONFLUENCE_USERNAME={{ $jira.username.value | quote }}
export CONFLUENCE_URL={{ printf "%s/wiki" $jira.hostname.value | quote }}

export SONARQUBE_TOKEN={{ onepasswordRead "op://focused/SonarQube/credential" | quote }}
export SONARQUBE_ORG=easyjet-dev
export SONARQUBE_URL=https://sonarcloud.io

export AWS_PROFILE=ej-dev
{{- end }}
