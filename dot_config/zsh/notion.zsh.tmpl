# ── Secrets group: Notion API (work hosts only) ───────────────────────────────
# Sourced by ~/.zshenv via the secrets loader. chezmoi-managed (.tmpl).
# Apply just this group:  chezmoi apply ~/.config/zsh/notion.zsh
#
# Whole block is gated to work hosts (kinto / latios); on non-work hosts this file
# renders to just this header and exports nothing (and runs zero op reads).
# Notion is a Focused work tool (SDD blog series, Agentic Engineering Hub, etc.).
{{- if has .chezmoi.hostname .host_groups.work }}

# Notion integration token — used by the Notion REST API for things the hosted
# Notion MCP can't do (e.g. uploading local images/PDFs to pages).
export NOTION_API_KEY={{ onepasswordRead "op://focused/Notion API Key/credential" | quote }}
export NOTION_TOKEN="$NOTION_API_KEY"
{{- end }}
